{
  "name": "slick/http",
  "description": "Slick/Http is an useful library for Web application foundation. It implements the PSR-7 message interface and has a middleware server, session handling and an HTTP client.",
  "license": "MIT",
  "homepage": "https://github.com/slickframework/http",
  "keywords": [
    "slick",
    "http",
    "request",
    "client",
    "psr-7",
    "psr-15",
    "psr-18"
  ],
  "version": "v4.0.0",
  "minimum-stability": "dev",
  "authors": [
    {
      "name": "Filipe Silva",
      "email": "silvam.filipe@gmail.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Slick\\Http\\": "src/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-curl": "*",
    "psr/http-client": "^1.0@dev",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "dev-master",
    "phpmd/phpmd": "dev-master",
    "phpspec/phpspec": "^8.0@dev",
    "phpstan/phpstan": "2.1.x-dev",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "provide": {
    "psr/http-message-implementation": "1.0"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "4.0-dev",
      "dev-develop": "4.1-dev"
    }
  },
  "scripts": {
    "test": "phpspec run -fdot",
    "check-style": "phpcs -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src",
    "fix-style": "phpcbf -p --standard=PSR2 --runtime-set ignore_errors_on_exit 1 --runtime-set ignore_warnings_on_exit 1 src",
    "phpmd": "phpmd --ignore-errors-on-exit src html build/phpmd.xml > build/phpmd.html",
    "stan": "phpstan analyse -l 6 src --memory-limit 512M",
    "lint": "php-cs-fixer fix --diff --using-cache=no"
  },
  "config": {
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
